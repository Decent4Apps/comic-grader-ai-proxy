{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"],
      "@/src/*": ["src/*"]
    },
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": true
  }
}
