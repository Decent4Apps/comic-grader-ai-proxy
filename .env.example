# Superagent AI Firewall base — MUST include /v1 exactly once
# Example:
#   https://firewall.superagent.sh/j97882v2grrbt5epxb8xtr1pyh7py3re/v1
SUPERAGENT_PROXY_URL="https://firewall.superagent.sh/<FIREWALL_ID>/v1"

# OpenAI key used as Bearer for OpenAI-compat passthrough
OPENAI_API_KEY="sk-your-openai-key"

# Optional
DEFAULT_MODEL="gpt-4o-mini"
