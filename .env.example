# You may paste just the base; the proxy will append /v1 automatically if missing
# e.g. https://firewall.superagent.sh/j97882v2grrbt5epxb8xtr1pyh7py3re
SUPERAGENT_PROXY_URL="https://firewall.superagent.sh/<FIREWALL_ID>"

# OpenAI key used as Bearer (OpenAI-compatible passthrough)
OPENAI_API_KEY="sk-your-openai-key"

# Optional
DEFAULT_MODEL="gpt-4o-mini"

# === Firecrawl ===
# Get from https://firecrawl.dev
FIRECRAWL_API_KEY=fc_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional (safe defaults if omitted)
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_SEARCH_LIMIT=6
FIRECRAWL_SCRAPE_CONCURRENCY=3
# Superagent Firewall (OpenAI-compatible gateway)
SUPERAGENT_PROXY_URL=https://firewall.superagent.sh/<your_config_id>/v1
SUPERAGENT_API_KEY=sa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model if client omits one
DEFAULT_MODEL=gpt-4o-mini

# Optional: Anthropic direct
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
