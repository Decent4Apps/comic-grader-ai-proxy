# Superagent AI Firewall (OpenAI-compatible base)
# Example: https://firewall.superagent.sh/j97882v2grrbt5epxb8xtr1pyh7py3re/v1
SUPERAGENT_PROXY_URL="https://firewall.superagent.sh/<FIREWALL_ID>/v1"

# Choose ONE auth mode (controls which key is used as Bearer):
#   - "openai": pass your OPENAI_API_KEY (firewall forwards to OpenAI)
#   - "proxy":  pass your SUPERAGENT_PROXY_KEY (firewall uses dashboard-configured upstream)
SUPERAGENT_AUTH_MODE="openai"

# If SUPERAGENT_AUTH_MODE=openai:
OPENAI_API_KEY="sk-..."

# If SUPERAGENT_AUTH_MODE=proxy:
SUPERAGENT_PROXY_KEY="sa_proxy_..."

# Default model (OpenAI-compatible name)
DEFAULT_MODEL="gpt-4o-mini"
