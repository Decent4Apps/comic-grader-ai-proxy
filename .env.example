# =========================
# ComicGraderAI – Proxy ENV
# =========================

# --- Superagent Firewall (OpenAI-compatible gateway) ---
# You can paste either:
#   https://firewall.superagent.sh/<CONFIG_ID>
# or:
#   https://firewall.superagent.sh/<CONFIG_ID>/v1
# The server will append '/v1' if missing.
SUPERAGENT_PROXY_URL=https://firewall.superagent.sh/<CONFIG_ID>
SUPERAGENT_API_KEY=sa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used when the client does not specify a model
DEFAULT_MODEL=gpt-4o-mini

# --- Anthropic (optional, only used for claude-* models direct) ---
# Leave empty to disable direct Anthropic calls.
ANTHROPIC_API_KEY=

# --- Firecrawl (optional pricing/scrape endpoints) ---
FIRECRAWL_API_KEY=fc_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_SEARCH_LIMIT=6
FIRECRAWL_SCRAPE_CONCURRENCY=3

# ===== Notes =====
# 1) DO NOT set Authorization: Bearer sa_... in your code. The route uses
#    x-api-key / x-superagent-api-key / x-superagent-token headers instead.
# 2) OPENAI_API_KEY is NOT required when using Superagent Firewall. If you
#    also want a direct-to-OpenAI path, add it below—but our /api/ai route
#    does not read it by design to avoid 401s with "sa_" keys.
# OPENAI_API_KEY=

# Trusted backend only; never use a public/client environment variable.
PAID_PROXY_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PAID_MAX_REQUESTS_PER_MINUTE=10
PAID_MAX_REQUESTS_PER_DAY=100
PAID_ALLOWED_MODELS=gpt-4o-mini
