# You may paste just the base; the proxy will append /v1 automatically if missing
# e.g. https://firewall.superagent.sh/j97882v2grrbt5epxb8xtr1pyh7py3re
SUPERAGENT_PROXY_URL="https://firewall.superagent.sh/<FIREWALL_ID>"

# OpenAI key used as Bearer (OpenAI-compatible passthrough)
OPENAI_API_KEY="sk-your-openai-key"

# Optional
DEFAULT_MODEL="gpt-4o-mini"

# --- Firecrawl ---
# You can keep the default base; override only if Firecrawl changes it.
FIRECRAWL_BASE="https://api.firecrawl.dev/v1"
FIRECRAWL_API_KEY="fc-...your-key..."

# Optional defaults
FIRECRAWL_DEFAULT_FORMAT="markdown"   # markdown | json | links | screenshot | summary
FIRECRAWL_DEFAULT_TIMEOUT="20000"     # milliseconds
